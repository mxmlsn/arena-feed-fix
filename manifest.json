{
  "manifest_version": 3,
  "name": "arena-feed-fix",
  "version": "3.10.3",
  "description": "Главная are.na как Explore: только блоки подписок, без своих и без дублей.",
  "content_scripts": [
    {
      "matches": [
        "https://www.are.na/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.are.na/*"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.are.na/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "arena-feed-fix"
  }
}